# Build output
/build/
dist/

# Python: the virtual environment for the repository's tools, their caches, and the metadata an
# editable install writes
.venv/
__pycache__/
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.egg-info/

# Editors and their personal settings
.vscode/
.idea/
.vs/

# Claude Code's personal files; the rest of .claude/ is shared
.claude/settings.local.json
.claude/launch.json

# Logs
*.log

# Never committed: secrets, and crash dumps, which can hold the app's memory
.env
*.dmp
