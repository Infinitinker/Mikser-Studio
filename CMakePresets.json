{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "MIKSERSTUDIO_INSTALLED_APP": "OFF" }
    },
    {
      "name": "package",
      "displayName": "Package (the installed app, for tools/build_release.py)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MIKSERSTUDIO_INSTALLED_APP": "ON",
        "MIKSERSTUDIO_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (warnings are errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MIKSERSTUDIO_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "package", "configurePreset": "package" },
    { "name": "ci", "configurePreset": "ci" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "e2e|gpu|timing" } }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "e2e|gpu|timing" } }
    },
    {
      "name": "timing",
      "displayName": "Timing tests",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "timing" } },
      "execution": { "repeat": { "mode": "until-pass", "count": 3 } }
    },
    {
      "name": "e2e",
      "displayName": "End-to-end tests",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "e2e" } }
    },
    {
      "name": "gpu",
      "displayName": "GPU test",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "gpu" } }
    }
  ]
}
