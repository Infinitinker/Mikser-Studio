{
    "id": "mikserstudio.ollama",
    "name": "Ollama",
    "version": "1.0.0",
    "description": "Generates text with the language models of an Ollama that runs on this computer or another one.",
    "apiVersion": 1,
    "entry": "main.lua",
    "permissions": ["network"],
    "network": ["127.0.0.1:*", "localhost:*", "[::1]:*", "*:*"],
    "settingsSection": "AI tools",
    "settingsSchema": {
        "type": "object",
        "properties": {
            "url": {
                "type": "string",
                "title": "Address",
                "description": "Where Ollama listens, such as http://127.0.0.1:11434.",
                "default": "http://127.0.0.1:11434",
                "pattern": "^https?://[^/\\s]+"
            }
        },
        "additionalProperties": false
    }
}
